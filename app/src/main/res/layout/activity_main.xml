<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART PANTRY"
            android:textColor="#477A52"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Make the most of your food."
            android:textColor="#20352A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage your ingredients and discover recipes using what you already have."
            android:textColor="#647267"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pantryCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="20dp"
            android:background="#E0EBDD"
            android:text="Your pantry&#10;0 ingredients stored"
            android:textColor="#20352A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/viewPantryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Manage My Pantry" />

        <Button
            android:id="@+id/suggestRecipesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Find Matching Recipes" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Less waste. More delicious meals."
            android:textColor="#477A52"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
