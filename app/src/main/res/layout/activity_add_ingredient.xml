<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#20352A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter the ingredient details below."
            android:textSize="15sp"
            android:textColor="#647267" />

        <EditText
            android:id="@+id/ingredientNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Ingredient name (e.g. Eggs)"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <EditText
            android:id="@+id/ingredientQuantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Quantity (e.g. 6)"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/ingredientUnitInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Unit (e.g. pieces, grams, ml)"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <EditText
            android:id="@+id/ingredientExpiryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Expiry date (optional: YYYY-MM-DD)"
            android:inputType="date"
            android:maxLines="1" />

        <Button
            android:id="@+id/saveIngredientButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save Ingredient" />

        <Button
            android:id="@+id/cancelIngredientButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancel" />

    </LinearLayout>
</ScrollView>